# 默认离线 Mock；真实调用还需 AI_ALLOW_PAID=true 和界面中的逐次同意。
AI_PROVIDER=mock
PORT=3000
DATA_DIR=./data
AI_ALLOW_PAID=false
# 优先用 Windows 用户环境变量保存 Key；此处仅为配置名示例。
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
QWEN_MODEL=qwen3.7-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Qwen 默认北京区；其他地区需对应 Key、官方端点及价格，详见说明。
AI_TIMEOUT_MS=240000
# DeepSeek 未配置时默认 16384，Qwen 默认 8192；界面可为本次批改另选额度。
AI_MAX_OUTPUT_TOKENS=16384
AI_MAX_RETRIES=1
AI_PRICE_DATE=2026-10-23
# 保守预算换算系数，不是实时汇率；DeepSeek 使用峰时 USD 单价换算。
AI_USD_CNY_BUDGET_RATE=8
# 如覆盖价格，以每百万 token 的人民币计价：
# DEEPSEEK_INPUT_CNY_PER_M=
# DEEPSEEK_OUTPUT_CNY_PER_M=
# DEEPSEEK_CACHED_CNY_PER_M=
# QWEN_INPUT_CNY_PER_M=
# QWEN_OUTPUT_CNY_PER_M=
# QWEN_CACHED_CNY_PER_M=
